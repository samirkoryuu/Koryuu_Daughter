# Discord Gateway companion service (run outside standard Cloudflare Workers)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_PUBLIC_KEY=
DISCORD_GUILD_ID=

# Immutable Discord user IDs (enable Developer Mode to copy IDs)
LILITH_USER_ID=
ASTERION_USER_ID=

# Gateway companion -> Worker API
WORKER_API_URL=http://127.0.0.1:8787
GATEWAY_SHARED_SECRET=

# Set this as a Cloudflare Worker secret, not in this file:
# GROQ_API_KEY
# DISCORD_BOT_TOKEN (the same bot token as DISCORD_TOKEN)
# ADMIN_PASSWORD_SHA256 (SHA-256 hex digest of the private admin password)
